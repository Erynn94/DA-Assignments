    <worksheet name='Food Insecurity Bar Chart'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Food Insecurity in the US (Dec 2023)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Food &amp; Children&apos;s Health' name='federated.1gq3ezg13t8ji114gtl3005uyd6c' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Average Income' caption='Measure Swap' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;2&quot;'>
              <calculation class='tableau' formula='&quot;2&quot;' />
              <aliases>
                <alias key='&quot;1&quot;' value='Estimated Count' />
                <alias key='&quot;2&quot;' value='Average Income' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1gq3ezg13t8ji114gtl3005uyd6c'>
            <column caption='Income Flag' datatype='integer' name='[Calculation_307933644851884033]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([FTOTVAL] &lt; 10, 1, 0)' />
            </column>
            <column caption='Prop Error' datatype='real' name='[Calculation_341288429593440256]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [Food Insecurity (group)]: SUM([Calculation_307933644851884033])/COUNT([Calculation_307933644851884033])}' />
            </column>
            <column caption='Change Measure' datatype='real' name='[Calculation_374432108128534528]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;1&apos; THEN SUM([FSSUPPWT])&#10;WHEN &apos;2&apos; THEN AVG([FTOTVAL])&#10;END' />
            </column>
            <column caption='Food Insecurity' datatype='string' name='[FSFOODS]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;1&quot;' value='Low' />
                <alias key='&quot;2&quot;' value='Medium Low' />
                <alias key='&quot;3&quot;' value='Medium High' />
                <alias key='&quot;4&quot;' value='High' />
